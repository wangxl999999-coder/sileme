page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  border: none;
  border-radius: 100rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 28rpx 0;
  line-height: 1.5;
}

.btn-primary::after {
  border: none;
}

.btn-danger {
  background: #ff4d4f;
  color: #fff;
  border: none;
  border-radius: 100rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-danger::after {
  border: none;
}

.btn-outline {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 100rpx;
}

.btn-outline::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #666;
  border: none;
}

.btn-ghost::after {
  border: none;
}

.status-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-active {
  background: #e6f7ea;
  color: #22c55e;
}

.status-warning {
  background: #fff7e6;
  color: #fa8c16;
}

.status-timeout {
  background: #fff1f0;
  color: #ff4d4f;
}

.status-sos {
  background: #ff4d4f;
  color: #fff;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.status-never {
  background: #f0f0f0;
  color: #999;
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 24rpx 0;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-muted {
  color: #999;
}

.text-danger {
  color: #ff4d4f;
}

.text-success {
  color: #22c55e;
}

.text-warning {
  color: #fa8c16;
}

.fs-24 {
  font-size: 24rpx;
}

.fs-32 {
  font-size: 32rpx;
}

.fs-48 {
  font-size: 48rpx;
}

.fw-600 {
  font-weight: 600;
}

.mt-8 {
  margin-top: 8rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mt-32 {
  margin-top: 32rpx;
}

.mb-8 {
  margin-bottom: 8rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.mb-32 {
  margin-bottom: 32rpx;
}

.empty-state {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

input, textarea {
  width: 100%;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 24rpx 28rpx;
  background: #f7f7f7;
  border-radius: 16rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.form-input:focus {
  background: #fff;
  border-color: #ff6b6b;
}

.form-input::placeholder {
  color: #ccc;
}

.row {
  display: flex;
  align-items: center;
}

.col {
  flex: 1;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
