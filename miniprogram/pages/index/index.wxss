.login-section {
  text-align: center;
  padding: 80rpx 40rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.login-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.login-btn {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

.greeting-section {
  padding: 40rpx 0 32rpx;
}

.greeting-text {
  text-align: left;
}

.greeting-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.greeting-subtitle {
  font-size: 28rpx;
  color: #999;
}

.checkin-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.checkin-circle {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e6f7ea, #d1fae5);
  margin: 0 auto 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.5s ease;
  box-shadow: 0 8rpx 40rpx rgba(34, 197, 94, 0.2);
}

.checkin-circle.checked {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  box-shadow: 0 8rpx 40rpx rgba(34, 197, 94, 0.4);
}

.checkin-circle.checked .checkin-icon,
.checkin-circle.checked .checkin-text,
.checkin-circle.checked .checkin-time {
  color: #fff;
}

.checkin-icon {
  font-size: 80rpx;
  color: #22c55e;
  margin-bottom: 8rpx;
}

.checkin-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #22c55e;
}

.checkin-time {
  font-size: 24rpx;
  color: #16a34a;
  margin-top: 4rpx;
}

.streak-info {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.streak-item {
  flex: 1;
  text-align: center;
}

.streak-number {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 4rpx;
}

.streak-label {
  font-size: 24rpx;
  color: #999;
}

.streak-divider {
  width: 1rpx;
  height: 60rpx;
  background: #f0f0f0;
}

.status-card {
  padding: 32rpx;
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.status-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.status-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.next-checkin {
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 20rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  display: inline-block;
}

.sos-section {
  margin: 48rpx 0;
  text-align: center;
}

.sos-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.sos-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.sos-button {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 48rpx rgba(255, 77, 79, 0.4);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.sos-button:active,
.sos-button.pressing {
  transform: scale(0.95);
  box-shadow: 0 8rpx 32rpx rgba(255, 77, 79, 0.5);
}

.sos-button.pressing {
  background: linear-gradient(135deg, #ff4d4f, #dc2626);
}

.sos-icon {
  font-size: 96rpx;
  margin-bottom: 8rpx;
}

.sos-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.sos-press-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
}

.press-progress {
  height: 100%;
  background: #fff;
  transition: width 0.1s linear;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 0;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-item {
  flex: 1;
  text-align: center;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666;
}

.calendar-section {
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #f7f7f7;
}

.calendar-day.checked {
  background: #e6f7ea;
}

.calendar-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e0e0e0;
  margin-bottom: 4rpx;
}

.calendar-day.checked .calendar-dot {
  background: #22c55e;
}

.calendar-date {
  font-size: 20rpx;
  color: #999;
}

.calendar-day.checked .calendar-date {
  color: #22c55e;
  font-weight: 600;
}

.privacy-tip {
  text-align: center;
  padding: 40rpx 0 80rpx;
  font-size: 24rpx;
  color: #999;
}
