.about-header {
  text-align: center;
  padding: 80rpx 0 60rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #ff6b6b;
  margin-bottom: 16rpx;
}

.app-version {
  font-size: 24rpx;
  color: #999;
}

.section {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.section-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.feature-list {
  margin-top: 8rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fff1f0;
  color: #ff6b6b;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.feature-text {
  flex: 1;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.sms-example {
  background: #fff7e6;
  border-left: 6rpx solid #fa8c16;
  padding: 24rpx;
  margin: 20rpx 0;
  font-size: 26rpx;
  color: #d46b08;
  border-radius: 0 12rpx 12rpx 0;
}

.privacy-list {
  margin-top: 16rpx;
}

.privacy-item {
  font-size: 26rpx;
  color: #666;
  line-height: 2;
}

.copyright {
  text-align: center;
  color: #ccc;
  font-size: 24rpx;
  padding: 48rpx 0;
}
