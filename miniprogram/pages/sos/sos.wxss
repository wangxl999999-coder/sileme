.page-header {
  padding: 40rpx 0 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #999;
}

.active-sos-card {
  background: linear-gradient(135deg, #ff4d4f, #dc2626);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.sos-alert {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.sos-pulse {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #fff;
  margin-right: 20rpx;
  animation: sosPulse 1.5s infinite;
}

@keyframes sosPulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(1.2);
  }
}

.sos-alert-text {
  flex: 1;
  color: #fff;
}

.alert-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.alert-time {
  font-size: 24rpx;
  opacity: 0.9;
}

.resolve-btn {
  background: #fff;
  color: #ff4d4f;
}

.resolve-btn::after {
  border: none;
}

.sos-list {
  margin-bottom: 32rpx;
}

.sos-item {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.sos-header {
  margin-bottom: 24rpx;
}

.sos-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sos-time {
  font-size: 24rpx;
  color: #999;
}

.notified-contacts {
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.contacts-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.contact-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.contact-name {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.contact-phone {
  font-size: 26rpx;
  color: #999;
}

.resolved-info {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.resolved-text {
  font-size: 24rpx;
  color: #22c55e;
}

.sos-actions {
  margin-top: 24rpx;
}

.empty-state {
  padding: 120rpx 0;
}

.empty-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}
