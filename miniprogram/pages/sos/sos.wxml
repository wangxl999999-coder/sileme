<view class="container">
  <view class="page-header">
    <view class="page-title">SOS呼救记录</view>
    <view class="page-subtitle">查看历史呼救信息</view>
  </view>

  <view wx:if="{{activeSOS}}" class="active-sos-card">
    <view class="sos-alert">
      <view class="sos-pulse"></view>
      <view class="sos-alert-text">
        <view class="alert-title">🚨 有未处理的SOS呼救</view>
        <view class="alert-time">触发时间: {{formatTime(activeSOS.triggerTime)}}</view>
      </view>
    </view>
    <button class="btn-danger resolve-btn" bindtap="resolveSOS" data-id="{{activeSOS._id}}">
      标记为已处理
    </button>
  </view>

  <view wx:if="{{sosRecords.length > 0}}" class="sos-list">
    <view wx:for="{{sosRecords}}" wx:key="_id" class="sos-item card">
      <view class="sos-header">
        <view class="sos-status">
          <view class="status-tag {{item.resolved ? 'status-active' : 'status-sos'}}">
            {{item.resolved ? '已处理' : '待处理'}}
          </view>
          <view class="sos-time">{{formatTime(item.triggerTime)}}</view>
        </view>
      </view>
      
      <view class="notified-contacts" wx:if="{{item.notifiedContacts && item.notifiedContacts.length > 0}}">
        <view class="contacts-title">已通知联系人:</view>
        <view wx:for="{{item.notifiedContacts}}" wx:for-item="contact" wx:key="phone" class="contact-row">
          <view class="contact-info">
            <text class="contact-name">{{contact.name}}</text>
            <text class="contact-phone">{{contact.phone}}</text>
          </view>
          <view class="contact-status">
            <text class="{{contact.notified ? 'text-success' : 'text-danger'}}">
              {{contact.notified ? '✓ 已通知' : '✗ 通知失败'}}
            </text>
          </view>
        </view>
      </view>

      <view wx:if="{{item.resolved}}" class="resolved-info">
        <view class="resolved-text">
          ✓ 已于 {{formatTime(item.resolvedTime)}} 标记为已处理
        </view>
      </view>

      <view wx:if="{{!item.resolved}}" class="sos-actions">
        <button class="btn-outline" bindtap="resolveSOS" data-id="{{item._id}}">
          标记为已处理
        </button>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <view class="empty-icon">🚨</view>
    <view class="empty-title">暂无SOS呼救记录</view>
    <view class="empty-desc">希望您永远不需要使用这个功能</view>
  </view>
</view>
