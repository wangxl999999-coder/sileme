<view class="container">
  <view class="page-header">
    <view class="page-title">家人状态看板</view>
    <view class="page-subtitle">实时查看家人的签到状态</view>
  </view>

  <view class="stats-grid">
    <view class="stat-card active">
      <view class="stat-number">{{stats.activeUsers || 0}}</view>
      <view class="stat-label">正常</view>
    </view>
    <view class="stat-card warning">
      <view class="stat-number">{{stats.warningUsers || 0}}</view>
      <view class="stat-label">注意</view>
    </view>
    <view class="stat-card timeout">
      <view class="stat-number">{{stats.timeoutUsers || 0}}</view>
      <view class="stat-label">超时</view>
    </view>
    <view class="stat-card sos">
      <view class="stat-number">{{stats.sosUsers || 0}}</view>
      <view class="stat-label">SOS</view>
    </view>
  </view>

  <view class="today-stats card">
    <view class="today-title">今日概览</view>
    <view class="today-row">
      <view class="today-item">
        <view class="today-value">{{stats.todayCheckIns || 0}}</view>
        <view class="today-label">今日已签到</view>
      </view>
      <view class="today-divider"></view>
      <view class="today-item">
        <view class="today-value">{{stats.totalUsers || 0}}</view>
        <view class="today-label">关注人数</view>
      </view>
      <view class="today-divider"></view>
      <view class="today-item">
        <view class="today-value">{{stats.activeSOSCount || 0}}</view>
        <view class="today-label">待处理SOS</view>
      </view>
    </view>
  </view>

  <view class="section-header">
    <view class="section-title">家人列表</view>
    <view class="filter-tabs">
      <view 
        wx:for="{{filterOptions}}" 
        wx:key="value"
        class="filter-tab {{currentFilter === item.value ? 'active' : ''}}"
        bindtap="changeFilter"
        data-value="{{item.value}}"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <view wx:if="{{users.length > 0}}" class="user-list">
    <view 
      wx:for="{{users}}" 
      wx:key="_id"
      class="user-card card {{item.computedStatus === 'sos' ? 'sos-card' : ''}}"
      bindtap="viewUserDetail"
      data-id="{{item._id}}"
    >
      <view class="user-header">
        <view class="user-avatar">{{item.nickname ? item.nickname.charAt(0) : '用'}}</view>
        <view class="user-info">
          <view class="user-name">{{item.nickname || '未命名'}}</view>
          <view wx:if="{{item.phone}}" class="user-phone">{{item.phone}}</view>
        </view>
        <view class="status-tag status-{{item.computedStatus}}">
          {{getStatusText(item.computedStatus)}}
        </view>
      </view>
      
      <view class="user-stats">
        <view class="stat-item">
          <view class="stat-label">最后签到</view>
          <view class="stat-value text-muted">
            {{item.lastCheckIn ? formatTime(item.lastCheckIn) : '从未签到'}}
          </view>
        </view>
        <view class="stat-item">
          <view class="stat-label">连续签到</view>
          <view class="stat-value">{{item.checkInStreak || 0}}天</view>
        </view>
      </view>

      <view wx:if="{{item.hoursSinceLastCheckIn !== null && item.hoursSinceLastCheckIn !== undefined}}" 
            class="time-indicator {{getTimeStatusClass(item.hoursSinceLastCheckIn)}}">
        距上次签到: {{formatDuration(item.hoursSinceLastCheckIn)}}
      </view>

      <view wx:if="{{item.hasCheckedInToday}}" class="today-checkin-badge">
        ✓ 今日已签到
      </view>
      <view wx:else class="today-checkin-badge missed">
        ✗ 今日未签到
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <view class="empty-icon">👨‍👩‍👧</view>
    <view class="empty-title">暂无关注的家人</view>
    <view class="empty-desc">
      {{userInfo.isAdmin ? '系统暂无用户' : '请联系管理员添加您为家人的管理者'}}
    </view>
  </view>
</view>
