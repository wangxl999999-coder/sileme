<view class="container">
  <view wx:if="{{user}}" class="user-profile card">
    <view class="profile-header">
      <view class="user-avatar">{{user.nickname ? user.nickname.charAt(0) : '用'}}</view>
      <view class="user-info">
        <view class="user-name">{{user.nickname || '未命名'}}</view>
        <view wx:if="{{user.phone}}" class="user-phone">{{user.phone}}</view>
        <view class="status-tag status-{{user.computedStatus}}">{{getStatusText(user.computedStatus)}}</view>
      </view>
    </view>
    
    <view class="status-info">
      <view class="info-row">
        <view class="info-label">最后在线</view>
        <view class="info-value">{{user.lastOnline ? formatTime(user.lastOnline) : '未知'}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">最后签到</view>
        <view class="info-value">{{user.lastCheckIn ? formatTime(user.lastCheckIn) : '从未签到'}}</view>
      </view>
      <view class="info-row" wx:if="{{hoursSinceLastCheckIn !== null}}">
        <view class="info-label">距上次签到</view>
        <view class="info-value text-danger">{{formatDuration(hoursSinceLastCheckIn)}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">连续签到</view>
        <view class="info-value">{{user.checkInStreak || 0}}天</view>
      </view>
      <view class="info-row">
        <view class="info-label">今日签到</view>
        <view class="info-value">
          <text class="{{user.hasCheckedInToday ? 'text-success' : 'text-danger'}}">
            {{user.hasCheckedInToday ? '✓ 已签到' : '✗ 未签到'}}
          </text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-title">紧急联系人</view>
  <view wx:if="{{contacts.length > 0}}" class="contacts-list">
    <view wx:for="{{contacts}}" wx:key="_id" class="contact-item card">
      <view class="contact-avatar">{{item.name.charAt(0)}}</view>
      <view class="contact-info">
        <view class="contact-name">
          {{item.name}}
          <view class="priority-tag" wx:if="{{item.priority > 1}}">优先级{{item.priority}}</view>
        </view>
        <view class="contact-phone">{{item.phone}}</view>
        <view class="contact-relation">{{getRelationshipText(item.relationship)}}</view>
      </view>
      <view class="contact-status">
        <view class="status-tag {{item.enabled ? 'status-active' : 'status-never'}}">
          {{item.enabled ? '已启用' : '已停用'}}
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="empty-state small">
    <text>暂无紧急联系人</text>
  </view>

  <view class="section-title">签到统计</view>
  <view class="stats-card card">
    <view class="stats-row">
      <view class="stat-item">
        <view class="stat-value">{{checkInStats.checkInCount || 0}}</view>
        <view class="stat-label">本月签到</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{checkInStats.checkInRate || 0}}%</view>
        <view class="stat-label">签到率</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{checkInStats.currentStreak || 0}}</view>
        <view class="stat-label">当前连续</view>
      </view>
    </view>
  </view>

  <view class="section-title">最近签到记录</view>
  <view wx:if="{{recentCheckIns.length > 0}}" class="checkin-list">
    <view wx:for="{{recentCheckIns}}" wx:key="_id" class="checkin-item card">
      <view class="checkin-icon">✓</view>
      <view class="checkin-info">
        <view class="checkin-date">{{formatDate(item.checkInTime)}}</view>
        <view class="checkin-time">{{formatTimeOnly(item.checkInTime)}}</view>
      </view>
      <view class="checkin-status status-tag status-{{item.status === 'success' ? 'active' : 'warning'}}">
        {{item.status === 'success' ? '手动签到' : '自动补签'}}
      </view>
    </view>
  </view>
  <view wx:else class="empty-state small">
    <text>暂无签到记录</text>
  </view>

  <view class="section-title">最近SOS记录</view>
  <view wx:if="{{recentSOS.length > 0}}" class="sos-list">
    <view wx:for="{{recentSOS}}" wx:key="_id" class="sos-item card">
      <view class="sos-icon">🚨</view>
      <view class="sos-info">
        <view class="sos-time">{{formatTime(item.triggerTime)}}</view>
        <view class="sos-status">
          <text class="{{item.resolved ? 'text-success' : 'text-danger'}}">
            {{item.resolved ? '已处理' : '待处理'}}
          </text>
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="empty-state small">
    <text>暂无SOS记录</text>
  </view>

  <view class="actions" wx:if="{{isAdmin}}">
    <button class="btn-outline" bindtap="manualCheckIn">
      手动补签
    </button>
  </view>
</view>
