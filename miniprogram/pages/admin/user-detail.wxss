.user-profile {
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-phone {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.status-info {
  margin-top: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin: 32rpx 0 20rpx;
}

.contacts-list {
  margin-bottom: 24rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.contact-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.contact-info {
  flex: 1;
}

.contact-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.priority-tag {
  background: #fff7e6;
  color: #fa8c16;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.contact-phone {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 2rpx;
}

.contact-relation {
  font-size: 22rpx;
  color: #bbb;
}

.contact-status {
  flex-shrink: 0;
}

.stats-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff6b6b;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.checkin-list,
.sos-list {
  margin-bottom: 24rpx;
}

.checkin-item,
.sos-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.checkin-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e6f7ea;
  color: #22c55e;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.sos-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.checkin-info,
.sos-info {
  flex: 1;
}

.checkin-date,
.sos-time {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.checkin-time,
.sos-status {
  font-size: 24rpx;
  color: #999;
}

.checkin-status {
  flex-shrink: 0;
}

.empty-state.small {
  padding: 40rpx 0;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  color: #999;
  font-size: 26rpx;
}

.actions {
  padding: 32rpx 0 48rpx;
}

.btn-outline {
  width: 100%;
}

.text-success {
  color: #22c55e;
}

.text-danger {
  color: #ff4d4f;
}
