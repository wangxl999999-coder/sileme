.page-header {
  padding: 40rpx 0 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #999;
}

.contacts-list {
  margin-bottom: 32rpx;
}

.contact-item {
  padding: 32rpx;
}

.contact-info {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.contact-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.contact-detail {
  flex: 1;
  min-width: 0;
}

.contact-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.priority-tag {
  background: #fff7e6;
  color: #fa8c16;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.contact-phone {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.contact-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.dot {
  margin: 0 8rpx;
}

.last-notified {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.contact-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.action-btn.edit {
  background: #f0f5ff;
  color: #1890ff;
}

.action-btn.test {
  background: #e6f7ea;
  color: #22c55e;
}

.action-btn.delete {
  background: #fff1f0;
  color: #ff4d4f;
}

.empty-state {
  padding: 120rpx 0 80rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.8;
}

.tips-card {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  margin-bottom: 40rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #d48806;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #ad6800;
  line-height: 2;
}

.add-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.add-btn {
  width: 100%;
}

.container {
  padding-bottom: 180rpx;
}
