.page-header {
  padding: 40rpx 0 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #999;
}

.required {
  color: #ff4d4f;
}

.relationship-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.relationship-item {
  padding: 20rpx 0;
  text-align: center;
  background: #f7f7f7;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.relationship-item.active {
  background: #fff1f0;
  color: #ff4d4f;
  border-color: #ff4d4f;
  font-weight: 500;
}

.priority-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.priority-slider {
  padding: 0 16rpx;
}

.notify-options {
  background: #f7f7f7;
  border-radius: 16rpx;
  overflow: hidden;
}

.notify-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.notify-option:last-child {
  border-bottom: none;
}

.notify-text {
  flex: 1;
}

.notify-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.notify-desc {
  font-size: 24rpx;
  color: #999;
}

.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
}

.container {
  padding-bottom: 180rpx;
}
