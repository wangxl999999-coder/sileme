<view class="container">
  <view class="page-header">
    <view class="page-title">签到记录</view>
    <view class="page-subtitle">共签到 {{total}} 次</view>
  </view>

  <view class="stats-card card">
    <view class="stats-grid">
      <view class="stat-item">
        <view class="stat-value">{{stats.currentStreak || 0}}</view>
        <view class="stat-label">当前连续</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{stats.checkInCount || 0}}</view>
        <view class="stat-label">本月签到</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{stats.checkInRate || 0}}%</view>
        <view class="stat-label">签到率</view>
      </view>
    </view>
  </view>

  <view class="calendar-card card">
    <view class="section-title">签到日历</view>
    <view class="calendar-weekdays">
      <view wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</view>
    </view>
    <view class="calendar-days">
      <view 
        wx:for="{{calendarDays}}" 
        wx:key="date"
        class="calendar-day {{item.checkedIn ? 'checked' : ''}} {{item.today ? 'today' : ''}} {{item.empty ? 'empty' : ''}}"
      >
        <view class="day-number">{{item.day}}</view>
        <view wx:if="{{!item.empty}}" class="dot {{item.checkedIn ? 'active' : ''}}"></view>
      </view>
    </view>
  </view>

  <view class="section-title history-title">最近签到</view>
  
  <view wx:if="{{checkIns.length > 0}}" class="checkin-list">
    <view wx:for="{{checkIns}}" wx:key="_id" class="checkin-item">
      <view class="checkin-icon">✓</view>
      <view class="checkin-info">
        <view class="checkin-date">{{formatDate(item.checkInTime)}}</view>
        <view class="checkin-time">{{formatTime(item.checkInTime)}}</view>
      </view>
      <view class="checkin-status status-tag status-{{item.status === 'success' ? 'active' : 'warning'}}">
        {{item.status === 'success' ? '手动签到' : '自动补签'}}
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <view class="empty-icon">📅</view>
    <view class="empty-title">暂无签到记录</view>
    <view class="empty-desc">每日打开小程序即可自动签到</view>
  </view>

  <view wx:if="{{hasMore && checkIns.length > 0}}" class="load-more">
    <button class="btn-ghost" bindtap="loadMore">
      {{loading ? '加载中...' : '加载更多'}}
    </button>
  </view>
</view>
