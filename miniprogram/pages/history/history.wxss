.page-header {
  padding: 40rpx 0 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.page-subtitle {
  font-size: 26rpx;
  color: #999;
}

.stats-card {
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #ff4d4f;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.calendar-card {
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.history-title {
  margin-bottom: 20rpx;
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 16rpx;
}

.weekday {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0;
}

.calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #fafafa;
}

.calendar-day.empty {
  background: transparent;
}

.calendar-day.today {
  border: 2rpx solid #ff4d4f;
}

.calendar-day.checked {
  background: #e6f7ea;
}

.day-number {
  font-size: 24rpx;
  color: #333;
}

.calendar-day.checked .day-number {
  color: #22c55e;
  font-weight: 600;
}

.calendar-day.today .day-number {
  color: #ff4d4f;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #e0e0e0;
  margin-top: 4rpx;
}

.dot.active {
  background: #22c55e;
}

.checkin-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.checkin-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.checkin-item:last-child {
  border-bottom: none;
}

.checkin-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e6f7ea;
  color: #22c55e;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.checkin-info {
  flex: 1;
}

.checkin-date {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.checkin-time {
  font-size: 24rpx;
  color: #999;
}

.checkin-status {
  flex-shrink: 0;
}

.empty-state {
  padding: 80rpx 0;
}

.empty-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

.load-more {
  padding: 32rpx 0 48rpx;
  text-align: center;
}
